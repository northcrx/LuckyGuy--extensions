{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LuckyGuyExtensionManifest",
  "type": "object",
  "required": ["id", "name", "version", "description", "entry"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique extension identifier (e.g. luckyguy-ext-pornhub)"
    },
    "name": {
      "type": "string",
      "description": "Exact human-readable plugin name (e.g. Pornhub, Telegram)"
    },
    "version": {
      "type": "string",
      "description": "Semver version string (e.g. 1.1.0)"
    },
    "description": {
      "type": "string",
      "description": "Summary of plugin capabilities"
    },
    "author": {
      "type": "string"
    },
    "entry": {
      "type": "string",
      "description": "Main javascript entry point relative to extension folder"
    },
    "type": {
      "type": "string",
      "enum": ["audio", "video", "crawler", "theme", "portal", "hybrid"],
      "description": "Type of plugin or engine"
    },
    "rating": {
      "type": "string",
      "enum": ["all", "mature", "18+"],
      "description": "Content rating flag for custom user/adult scrapers"
    },
    "tab": {
      "type": "object",
      "description": "Declare a custom dedicated tab in the LuckyGuy navigation sidebar",
      "required": ["title"],
      "properties": {
        "title": { "type": "string", "description": "Tab label displayed in sidebar (e.g. Pornhub, Telegram)" },
        "icon": { "type": "string", "description": "Duo-tone or branded icon name (e.g. Pornhub, Video, Film, Send, Sparkles, DownloadCloud, Image)" },
        "url": { "type": "string", "description": "Default source URL or portal loaded inside tab view" },
        "badge": { "type": "string", "description": "Optional pill tag (e.g. HD, MEDIA)" },
        "viewLayout": {
          "type": "string",
          "enum": ["cinema", "gallery", "feed", "web"],
          "description": "Layout style: cinema (video playback focus), gallery (masonry image cards), feed, or web"
        }
      }
    },
    "crawler": {
      "type": "object",
      "description": "Headless webview crawler and auto-scroller configuration",
      "properties": {
        "scrollStrategy": {
          "type": "object",
          "properties": {
            "step": { "type": "number", "description": "Pixel scroll jump per cycle (e.g. 600)" },
            "interval": { "type": "number", "description": "Millisecond interval between scroll cycles (e.g. 800)" },
            "maxScrollCycles": { "type": "number", "description": "Maximum auto-scroll iterations before extracting (e.g. 8)" }
          }
        },
        "mediaGrid": {
          "type": "object",
          "properties": {
            "itemSelector": { "type": "string", "description": "CSS selector matching each media card" },
            "titleSelector": { "type": "string", "description": "CSS selector matching item title" },
            "lazyAttributes": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Fallback image attribute chain: ['data-mediumthumb', 'data-image', 'data-thumb_url', 'data-src', 'src']"
            },
            "durationSelector": { "type": "string", "description": "CSS selector for duration" },
            "uploaderSelector": { "type": "string", "description": "CSS selector for artist / uploader" }
          }
        }
      }
    },
    "streamResolver": {
      "type": "object",
      "description": "Direct video / audio stream resolution specifications",
      "properties": {
        "formats": {
          "type": "array",
          "items": { "type": "string", "enum": ["MP4", "HLS", "DASH", "WEBM"] }
        },
        "defaultQuality": { "type": "string", "description": "Default quality preferred (e.g. 1080p, 720p)" },
        "headers": {
          "type": "object",
          "description": "Required HTTP headers for CDN playback and chunked downloading (e.g. Referer, User-Agent)"
        }
      }
    },
    "videoPlayer": {
      "type": "object",
      "description": "Integration with LuckyGuy's custom in-app video player",
      "properties": {
        "flushTop": { "type": "boolean", "description": "Starts video player flush at the top with zero toolbar margin" },
        "qualitySelector": { "type": "boolean", "description": "Enables in-player resolution selector (1080p, 720p, 480p)" },
        "directDownload": { "type": "boolean", "description": "Enables one-click download directly inside player" },
        "autoIndexToVideosTab": { "type": "boolean", "description": "Downloaded video is automatically indexed into the Videos tab" }
      }
    },
    "downloader": {
      "type": "object",
      "description": "Downloader and storage pipeline routing",
      "properties": {
        "targetDirectory": {
          "type": "string",
          "enum": ["Videos", "Downloads", "Music"],
          "description": "Target folder on user's system (defaults to Videos for video files)"
        },
        "rangeHeaders": { "type": "boolean", "description": "Enable HTTP Range requests for resume and segmented chunking" },
        "retryOnReset": { "type": "boolean", "description": "Auto-retry on ECONNRESET socket drops" }
      }
    },
    "settings": {
      "type": "object",
      "description": "Declare custom settings, API credentials, and options rendered in dedicated Settings tab",
      "required": ["title", "fields"],
      "properties": {
        "title": { "type": "string", "description": "Settings section title" },
        "description": { "type": "string", "description": "Help text explaining plugin setup requirements" },
        "fields": {
          "type": "array",
          "description": "Interactive settings fields rendered automatically in LuckyGuy settings",
          "items": {
            "type": "object",
            "required": ["id", "label", "type"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "type": {
                "type": "string",
                "enum": ["text", "password", "select", "boolean", "number", "folder", "code", "textarea"]
              },
              "placeholder": { "type": "string" },
              "defaultValue": {},
              "description": { "type": "string" },
              "options": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "label": { "type": "string" },
                    "value": {}
                  }
                }
              }
            }
          }
        }
      }
    },
    "domainAliases": {
      "type": "array",
      "description": "Auto-redirect blocked or regional domains (e.g. pornhub.com -> pornhub.org)",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "region": { "type": "string" }
        }
      }
    },
    "cookies": {
      "type": "array",
      "description": "Session disclaimer / consent cookies auto-injected for electron session and webview",
      "items": {
        "type": "object",
        "required": ["name", "value"],
        "properties": {
          "name": { "type": "string" },
          "value": { "type": "string" },
          "url": { "type": "string" }
        }
      }
    },
    "mediaTypes": {
      "type": "array",
      "description": "Supported media kinds: video, image, audio, album",
      "items": { "type": "string" }
    },
    "capabilities": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Declared capabilities: stream, search, crawlPage, download, videoPlayer, adblock, imageGallery"
    },
    "supportedUrls": {
      "type": "array",
      "items": { "type": "string" }
    },
    "adBlockRules": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Custom domain patterns or ad scripts to block for this provider"
    }
  }
}
